# Connection string direta do Supabase (Settings > Database > Connection string > URI).
# Direct connection (porta 5432) é a recomendada para serviços persistentes como o Render.
# Troque [YOUR-PASSWORD] pela senha do banco (percent-encode se tiver caracteres especiais).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.SEU-PROJETO.supabase.co:5432/postgres"
JWT_SECRET=troque_essa_chave
CLIENT_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
ADMIN_USERNAME=lallo
ADMIN_PASSWORD=troque_essa_senha
